<script>
        // Micro-interaction: Randomize terminal lines occasionally to simulate live feed
        const terminal = document.querySelector('.terminal-container');
        const logs = [
            "INF: Port 80 identified as closed. Redirect found to 443.",
            "DBG: Script injection payload test initiated on /api/v1/auth.",
            "INF: Comparing server fingerprint with database v98.4.",
            "RES: Server identified as Nginx 1.25.4 (Stable).",
            "WRN: Insecure cipher suite found: TLS_RSA_WITH_AES_128_CBC_SHA",
            "INF: Brute-force resistance check passed."
        ];

        function addLog() {
            const p = document.createElement('p');
            p.className = 'text-surface-bright/60 animate-in fade-in slide-in-from-bottom-1 duration-500';
            const timestamp = new Date().toISOString().replace('T', ' ').substring(0, 19);
            const randomLog = logs[Math.floor(Math.random() * logs.length)];
            p.innerText = `[${timestamp}] ${randomLog}`;
            
            // Keep it tidy
            if (terminal.children.length > 50) {
                terminal.removeChild(terminal.firstChild);
            }
            
            terminal.appendChild(p);
            terminal.scrollTop = terminal.scrollHeight;
        }

        setInterval(addLog, 4000);
    </script>
